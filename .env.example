# Neon Postgres, free plan (no card needed): https://console.neon.tech
# Project > Dashboard > Connect. Copy both strings.
#
# Pooled (host contains "-pooler"): used by the web app, one short connection per request.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct: used by migrations, the seed, the nightly reset and the tests (they need session features).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Direct string for the separate "test" branch. The tests empty its tables, so never point this at main.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=require
