{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "rewrites": [
    { "source": "/((?!api/|assets/|samples/|og\\.png|favicon\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{web/**,synth/**,eval/**,tests/**,docs/**,public/**,.github/**}"
    }
  }
}
